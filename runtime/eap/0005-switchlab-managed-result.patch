--- /dev/null
+++ b/wpa_supplicant/switchlab_managed.h
@@ -0,0 +1,231 @@
+/* Switch Lab managed transport observations; BSD-3-Clause like upstream.
+ * Only typed callbacks write this private channel. Diagnostics are not input.
+ */
+#include <signal.h>
+
+static int sl_fd = -1, sl_failed, sl_peer;
+static u32 sl_sequence, sl_bytes;
+static unsigned int sl_wait = 3, sl_attempts = 3;
+
+static void sl_fail(void)
+{
+	if (!sl_failed) {
+		sl_failed = 1;
+		fprintf(stderr, "Managed result channel failed\n");
+	}
+	eloop_terminate();
+}
+
+static int sl_emit(u8 kind, const void *payload, size_t len)
+{
+	u8 frame[8192];
+	ssize_t written;
+	if (sl_fd < 0)
+		return 0;
+	if (sl_failed || len > sizeof(frame) - 16 || sl_sequence >= 512 ||
+	    sl_bytes + len + 16 > 1048576) {
+		sl_fail();
+		return -1;
+	}
+	os_memcpy(frame, "SLR1", 4);
+	frame[4] = kind;
+	frame[5] = frame[6] = frame[7] = 0;
+	WPA_PUT_BE32(frame + 8, len);
+	WPA_PUT_BE32(frame + 12, ++sl_sequence);
+	if (len)
+		os_memcpy(frame + 16, payload, len);
+	/* Nonblocking, one bounded write: partial/backpressured output fails the
+	 * attempt. No callback waits for an absent reader or retries forever. */
+	written = write(sl_fd, frame, len + 16);
+	forced_memzero(frame, sizeof(frame));
+	if (written != (ssize_t) (len + 16)) {
+		sl_fail();
+		return -1;
+	}
+	sl_bytes += len + 16;
+	return 0;
+}
+
+static int sl_open(const char *value)
+{
+	char *end;
+	long fd;
+	struct stat st;
+	int flags;
+	if (sl_fd >= 0 || !value || !*value)
+		return -1;
+	fd = strtol(value, &end, 10);
+	if (*end || fd < 3 || fd > 1048576 || fstat(fd, &st) ||
+	    !S_ISFIFO(st.st_mode))
+		return -1;
+	flags = fcntl(fd, F_GETFL);
+	if (flags < 0 || (flags & O_ACCMODE) != O_WRONLY ||
+	    fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0)
+		return -1;
+	signal(SIGPIPE, SIG_IGN);
+	sl_fd = fd;
+	return 0;
+}
+
+static int sl_number(const char *value, unsigned int max, unsigned int *out)
+{
+	char *end;
+	unsigned long n;
+	if (!value || !*value)
+		return -1;
+	n = strtoul(value, &end, 10);
+	if (*end || n < 1 || n > max)
+		return -1;
+	*out = n;
+	return 0;
+}
+
+static void sl_integer(u8 kind, u32 value)
+{
+	u8 bytes[4];
+	WPA_PUT_BE32(bytes, value);
+	sl_emit(kind, bytes, sizeof(bytes));
+}
+
+static void sl_eap(u8 direction, int type, const u8 *data, size_t len)
+{
+	u8 event[16] = {0};
+	if (sl_fd < 0)
+		return;
+	event[0] = direction; /* 1 peer->NAS, 2 NAS->peer */
+	event[1] = EAPOL_VERSION;
+	event[2] = type;
+	os_memcpy(event + 8, eapol_test.own_addr, ETH_ALEN);
+	if (type == IEEE802_1X_TYPE_EAP_PACKET && len >= 4) {
+		event[3] = data[0];
+		event[4] = data[1];
+		event[5] = len > 4 ? data[4] : 0;
+		WPA_PUT_BE16(event + 6, len);
+	}
+	sl_emit(3, event, sizeof(event));
+}
+
+static int sl_validate(void *ctx, struct radius_msg *msg,
+		       struct radius_msg *req, const u8 *secret, size_t secret_len)
+{
+	const u8 *packet = wpabuf_head(radius_msg_get_buf(msg));
+	size_t len = wpabuf_len(radius_msg_get_buf(msg)), pos, eap_len = 0;
+	u8 eap[4096];
+	int eap_seen = 0, eap_finished = 0, ma_count = 0;
+	(void) ctx;
+	if (len < 20 || len > 4096 || WPA_GET_BE16(packet + 2) != len ||
+	    (packet[0] != RADIUS_CODE_ACCESS_ACCEPT &&
+	     packet[0] != RADIUS_CODE_ACCESS_REJECT &&
+	     packet[0] != RADIUS_CODE_ACCESS_CHALLENGE))
+		goto invalid;
+	for (pos = 20; pos < len; pos += packet[pos + 1]) {
+		size_t alen;
+		if (pos + 2 > len || packet[pos + 1] < 2 ||
+		    pos + packet[pos + 1] > len)
+			goto invalid;
+		alen = packet[pos + 1] - 2;
+		if (packet[pos] == RADIUS_ATTR_MESSAGE_AUTHENTICATOR) {
+			if (++ma_count != 1 || alen != 16)
+				goto invalid;
+		}
+		if (packet[pos] == RADIUS_ATTR_EAP_MESSAGE) {
+			if (eap_finished || eap_len + alen > sizeof(eap))
+				goto invalid;
+			eap_seen = 1;
+			os_memcpy(eap + eap_len, packet + pos + 2, alen);
+			eap_len += alen;
+		} else if (eap_seen)
+			eap_finished = 1;
+	}
+	if (ma_count != 1 || (eap_seen &&
+	    (eap_len < 4 || WPA_GET_BE16(eap + 2) != eap_len ||
+	     eap[0] < 1 || eap[0] > 4 ||
+	     (eap[0] <= 2 ? eap_len < 5 : eap_len != 4))))
+		goto invalid;
+	forced_memzero(eap, sizeof(eap));
+	if (radius_msg_verify(msg, secret, secret_len, req, 1))
+		goto invalid;
+	return 1;
+invalid:
+	forced_memzero(eap, sizeof(eap));
+	sl_integer(6, 1); /* Invalid packet, not an authenticated Reject. */
+	return 0;
+}
+
+static void sl_packet(void *ctx, int kind, int sock, struct radius_msg *msg,
+		      const u8 *request_authenticator)
+{
+	struct sockaddr_storage peer, local;
+	socklen_t plen = sizeof(peer), llen = sizeof(local);
+	u8 record[64 + 4096] = {0};
+	struct wpabuf *buf = radius_msg_get_buf(msg);
+	size_t len = wpabuf_len(buf);
+	(void) ctx;
+	if (sl_fd < 0)
+		return;
+	if (len > 4096 || getpeername(sock, (struct sockaddr *) &peer, &plen) ||
+	    getsockname(sock, (struct sockaddr *) &local, &llen) ||
+	    peer.ss_family != local.ss_family)
+		goto failed;
+	if (peer.ss_family == AF_INET) {
+		struct sockaddr_in *p = (struct sockaddr_in *) &peer;
+		struct sockaddr_in *l = (struct sockaddr_in *) &local;
+		record[0] = 4;
+		os_memcpy(record + 4, &p->sin_port, 2);
+		os_memcpy(record + 6, &l->sin_port, 2);
+		os_memcpy(record + 8, &p->sin_addr, 4);
+		os_memcpy(record + 24, &l->sin_addr, 4);
+	} else if (peer.ss_family == AF_INET6) {
+		struct sockaddr_in6 *p = (struct sockaddr_in6 *) &peer;
+		struct sockaddr_in6 *l = (struct sockaddr_in6 *) &local;
+		record[0] = 6;
+		os_memcpy(record + 4, &p->sin6_port, 2);
+		os_memcpy(record + 6, &l->sin6_port, 2);
+		os_memcpy(record + 8, &p->sin6_addr, 16);
+		os_memcpy(record + 24, &l->sin6_addr, 16);
+	} else
+		goto failed;
+	if (request_authenticator)
+		os_memcpy(record + 40, request_authenticator, 16);
+	WPA_PUT_BE32(record + 56, len);
+	os_memcpy(record + 64, wpabuf_head(buf), len);
+	sl_emit(kind, record, 64 + len);
+	forced_memzero(record, sizeof(record));
+	return;
+failed:
+	forced_memzero(record, sizeof(record));
+	sl_fail();
+}
+
+static void sl_complete(void *ctx, void *unused)
+{
+	(void) ctx;
+	(void) unused;
+	eloop_terminate();
+}
+
+static void sl_exhausted(void *ctx)
+{
+	struct eapol_test_data *e = ctx;
+	e->auth_timed_out = 1;
+	eloop_terminate();
+}
+
+static void sl_terminal(void)
+{
+	u8 record[32];
+	if (sl_fd < 0)
+		return;
+	WPA_PUT_BE32(record, eapol_test.radius_access_accept_received);
+	WPA_PUT_BE32(record + 4, eapol_test.radius_access_reject_received);
+	WPA_PUT_BE32(record + 8, eapol_test.auth_timed_out);
+	WPA_PUT_BE32(record + 12, eapol_test.num_mppe_ok);
+	WPA_PUT_BE32(record + 16, eapol_test.num_mppe_mismatch);
+	WPA_PUT_BE32(record + 20, eapol_test.num_cert_errors);
+	WPA_PUT_BE32(record + 24, sl_peer);
+	WPA_PUT_BE32(record + 28, eapol_test.preparation_failed);
+	if (!sl_failed)
+		sl_emit(7, record, sizeof(record));
+	close(sl_fd);
+	sl_fd = -1;
+}
