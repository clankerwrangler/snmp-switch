# Copy to .env beside compose.yaml and change what you need; then run `docker compose up -d`.
# Every setting is optional.

# Host address the web UI, SNMP and CoA are published on. The default 127.0.0.1 is this
# computer only; use an IPv4 address of this host to reach Switch Lab from the LAN.
# SWITCHLAB_BIND_ADDRESS=192.168.1.50

# Host ports. Inside the container Switch Lab always listens on 8000, 161 and 3799, so the
# UI needs no matching change. Use a higher SNMP port such as 1161 if the host cannot
# publish 161.
# SWITCHLAB_HTTP_PORT=8000
# SWITCHLAB_SNMP_PORT=161
# SWITCHLAB_COA_PORT=3799

# Start Switch Lab again after a reboot (Compose restart policy). The default "no" runs it
# only when you start it.
# SWITCHLAB_RESTART=unless-stopped

# Set to 1 when an HTTPS reverse proxy serves the UI.
# SWITCHLAB_SECURE_COOKIES=0
